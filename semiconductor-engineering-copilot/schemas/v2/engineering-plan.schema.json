{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EngineeringPlanV2",
  "description": "Schema for AI agent multi-step engineering plans, dependency graphs, and replanning triggers.",
  "type": "object",
  "required": ["plan_id", "task_name", "target_domain", "stages", "confidence_score"],
  "properties": {
    "plan_id": { "type": "string" },
    "task_name": { "type": "string" },
    "target_domain": { "type": "string" },
    "confidence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_id", "name", "tool_calls", "dependencies"],
        "properties": {
          "stage_id": { "type": "string" },
          "name": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "tool_calls": { "type": "array", "items": { "type": "string" } },
          "gate_condition": { "type": "string" }
        }
      }
    },
    "replan_triggers": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
